# Copie este arquivo para .env (ou exporte as variáveis antes de rodar)

# Opcional: API gratuita da Groq (https://console.groq.com/keys)
# Se não estiver definida, o assistente tenta Ollama e depois o modo offline.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Opcional: Ollama local (100% open-source). Padrão abaixo.
# Para instalar modelos: `ollama pull llama3.2`
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Timeout das chamadas de IA, em segundos
AI_TIMEOUT=60

# ==== Voz (TTS) ====
# Piper TTS open-source rodando local (padrão abaixo). Para ativar:
#   pip install piper-tts
#   python3 -m piper.http_server -m pt_BR-faber-medium -p 5000
PIPER_URL=http://localhost:5000
PIPER_VOICE=pt_BR-faber-medium
# Se o Piper não estiver rodando, o navegador usa a voz nativa gratuita.
TTS_TIMEOUT=20
